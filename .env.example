# ======================
# Database
# ======================
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ======================
# Spring Profile
# ======================
SPRING_PROFILES_ACTIVE=prod

# ======================
# JWT (REQUIRED - app will NOT start without this)
# Generate: openssl rand -base64 48
# ======================
JWT_SECRET=REPLACE_WITH_NEW_JWT_SECRET

# ======================
# TOTP Encryption (REQUIRED - app will NOT start without this)
# Must be at least 32 characters
# Generate: openssl rand -base64 32
# ======================
TOTP_ENCRYPTION_KEY=REPLACE_WITH_NEW_TOTP_KEY

# ======================
# Google OAuth
# ======================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_NEW_GOOGLE_CLIENT_SECRET

# ======================
# Frontend Redirect
# ======================
FRONTEND_REDIRECT_URL=

# ======================
# File Upload
# ======================
FILE_UPLOAD_TEMP_DIR=/app/temp-uploads/

# ======================
# AWS S3
# ======================
AWS_S3_ACCESS_KEY=your-key
AWS_S3_SECRET_KEY=your-secret
AWS_S3_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=tradestream-exports