# ======================
# Database
# ======================
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ======================
# Spring Profile
# ======================
SPRING_PROFILES_ACTIVE=prod

# ======================
# JWT
# Generate a new long random secret
# ======================
JWT_SECRET=REPLACE_WITH_NEW_JWT_SECRET

# ======================
# Google OAuth
# ======================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_NEW_GOOGLE_CLIENT_SECRET

# ======================
# Frontend Redirect
# ======================
FRONTEND_REDIRECT_URL=

# ======================
# File Upload
# ======================
FILE_UPLOAD_TEMP_DIR=/app/temp-uploads/

# ======================
# TOTP Encryption
# Generate a new random key
# ======================
TOTP_ENCRYPTION_KEY=REPLACE_WITH_NEW_TOTP_KEY